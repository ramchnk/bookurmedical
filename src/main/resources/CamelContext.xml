			<!-- For publish updateItem msg to batch -->
			<when>
				<simple>${exchangeProperty.isPublishSyncMsgToBatch} == true</simple>
				<process ref="prepareSyncPublishMessage" />
				<to uri="direct:publishToMQ" />
			</when>
