	<!-- The camel route context -->
	<camelContext id="camel" xmlns="http://camel.apache.org/schema/spring">

		<route id="processBidNotification">
			<from uri="direct:processBidNotification" />
			<process ref="initBidRoute" />
			<process ref="insertBidNotification" />
			<to uri="direct:loadInventoryData" />
			<process ref="loadUserDataByNicknameId" />
			<choice>
				<when>
					<simple>${exchangeProperty.isSyncRequired} == true and
						${exchangeProperty.ignoreSoldEvent} == false
					</simple>
					<process ref="updateInventoryForBidMessage" />
					<to uri="direct:publishToMQForItemSync" />
				</when>
				<otherwise>
					<process ref="updateInventoryWithBidAmount" />
				</otherwise>
			</choice>
		</route>

		<route id="processOrderNotification">
			<from uri="direct:processOrderNotification" />
			<process ref="loadAndProcessOrderFromDB" />
			<process ref="loadUserDataByNicknameId" />
			<process ref="processOrderStatus" />
			<split parallelProcessing="false" strategyRef="aggregatorStrategy">
				<method ref="splitterBean" method="splitOrders" />
				<to uri="direct:processOrderItem" />
			</split>
			<process ref="updateOrderDBQuery" />
			<when>
			       <simple>${exchangeProperty.stopProcess} == true</simple>
			       <stop />
			</when>
			<when>
				<simple>${exchangeProperty.processRule} == true and ${exchangeProperty.isNewOrder} == true</simple>
				<to uri="direct:processRuleRoute" />
			</when>
			<when>
				<simple>${exchangeProperty.hasCombinedOrderIds} == true</simple>
				<to uri="direct:updateCombineOrderIds" />
			</when>
			<process ref="prepareRequestMessage" />
			<to uri="direct:publishOrderNotificationToMQ" />
			<when>
				<simple>${exchangeProperty.isOrderUpdatedByShippingCarrier} == true</simple>
				<to uri="direct:publishToMQForUpdateOrder" />
			</when>
		</route>

		<route id="processRule">
			<from uri="direct:processRuleRoute" />
			<process ref="getRuleList" />
			<to uri="mongodb:mongoInventoryBean?database={{mongo.inventory.database}}&amp;collection=ruleOrder&amp;operation=findAll"
				pattern="InOut" />
				<process ref="processRuleList" />
		</route>

		<route id="updateCombineOrderIds">
			<from uri="direct:updateCombineOrderIds" />
			<!-- TODO update feeManagement about this combined invoice -->
			<process ref="updateCombineOrderStatus" />
		</route>

		<route id="processOrderItem">
			<from uri="direct:processOrderItem" />
			<process ref="initOrderItemRoute" />
			<when>
				<simple>${exchangeProperty.hasSKU} == true</simple>
				<to uri="direct:loadInventoryData" />
				<when>
					<simple>${exchangeProperty.ignoreSoldEvent} == false and
						${exchangeProperty.hasCombinedOrderIds} == false and
						${exchangeProperty.hasInventoryInDB} == true
					</simple>
					<choice>
						<when>
							<simple>${exchangeProperty.isEligibleToProceed} == true and
								${exchangeProperty.syncBundleSKUs} == true and
								${exchangeProperty.customSKU} != null
							</simple>
							<to uri="direct:syncBundleSKUs" />
						</when>
						<when>
							<simple>${exchangeProperty.syncMultipleUnitSKUs} == true and
								${exchangeProperty.customSKU} != null
							</simple>
							<setProperty propertyName="isMultipleUnitSKUUpdate">
								<simple>true</simple>
							</setProperty>
							<to uri="direct:loadBasicUnitSKU" />
							<choice>
								<when>
									<simple>${body} != null</simple>
									<setProperty propertyName="inventory">
										<simple>${body}</simple>
									</setProperty>
									<to uri="direct:updateAndPublish" />
									<when>
										<simple>${exchangeProperty.quantityModified} == true</simple>
										<to uri="direct:syncDuplicateSKUs" />
										<to uri="direct:loadMultipleUnitSKUs" />
										<split parallelProcessing="false">
											<simple>${body}</simple>
											<process ref="setMultipleUnitQuantity" />
											<to uri="direct:updateAndPublish" />
										</split>
									</when>
								</when>
								<otherwise>
									<to uri="direct:updateSKUQuantity" />
								</otherwise>
							</choice>
						</when>
						<otherwise>
							<to uri="direct:updateSKUQuantity" />
						</otherwise>
					</choice>
				</when>
			</when>
		</route>

		<route id="syncBundleSKUs">
			<from uri="direct:syncBundleSKUs" />
			<process ref="initSyncBundleSKUs" />
			<when>
				<simple>${exchangeProperty.isEligibleToProcess} == true</simple>
				<to uri="direct:updateInventoryStock" />
				<process ref="updateSoldInventoryDetails" />
			</when>
		</route>

		<route id="updateInventoryStock">
			<from uri="direct:updateInventoryStock" />
			<to uri="freemarker:classpath:templates/updateInventory.ftl?contentCache=true" />
			<choice>
				<when>
					<simple>${exchangeProperty.isOutOfStock} == true</simple>
					<setProperty propertyName="apiName">
						<constant>quantity</constant>
					</setProperty>
				</when>
				<otherwise>
					<setProperty propertyName="apiName">
						<constant>quantityDiff</constant>
					</setProperty>
				</otherwise>
			</choice>
			<process ref="buildInventoryAPIHeader" />
			<setHeader headerName="CamelHttpMethod">
				<constant>PUT</constant>
			</setHeader>
			<recipientList>
				<simple>${exchangeProperty.inventoryUrl}?throwExceptionOnFailure=false
				</simple>
			</recipientList>
			<process ref="processInventoryUpdateResponse" />
		</route>

		<route id="updateSKUQuantity">
			<from uri="direct:updateSKUQuantity" />
			<to uri="direct:updateAndPublish" />
			<to uri="direct:syncDuplicateSKUs" />
		</route>

		<route id="syncDuplicateSKUs">
			<from uri="direct:syncDuplicateSKUs" />
			<when>
				<simple>${exchangeProperty.syncDuplicateSKUs} == true and
					${exchangeProperty.customSKU} != null
				</simple>
				<to uri="direct:loadDuplicateSKUs" />
				<split parallelProcessing="false">
					<simple>${body}</simple>
					<setProperty propertyName="inventory">
						<simple>${body}</simple>
					</setProperty>
					<to uri="direct:updateAndPublish" />
				</split>
			</when>
		</route>

		<route id="updateAndPublish">
			<from uri="direct:updateAndPublish" />
			<process ref="updateInventoryDBQuery" />
			<to uri="direct:publishToMQForItemSync" />
		</route>

		<route id="loadInventoryData">
			<from uri="direct:loadInventoryData" />
			<process ref="prepareSKUDBQuery" />
			<to uri="mongodb:mongoInventoryBean?database={{mongo.inventory.database}}&amp;collection=inventory&amp;operation=findAll"
				pattern="InOut" />
			<process ref="processSKUDBQuery" />
		</route>

		<route id="loadDuplicateSKUs">
			<from uri="direct:loadDuplicateSKUs" />
			<setProperty propertyName="publishDuplicatSKUS">
				<simple>true</simple>
			</setProperty>
			<process ref="prepareDuplicateSKUsDBQuery" />
			<to uri="mongodb:mongoInventoryBean?database={{mongo.inventory.database}}&amp;collection=inventory&amp;operation=findAll"
				pattern="InOut" />
		</route>

		<route id="loadBasicUnitSKU">
			<from uri="direct:loadBasicUnitSKU" />
			<process ref="prepareBasicUnitSKUQuery" />
			<to
				uri="mongodb:mongoInventoryBean?database={{mongo.inventory.database}}&amp;collection=inventory&amp;operation=findOneByQuery"
				pattern="InOut" />
		</route>

		<route id="loadMultipleUnitSKUs">
			<from uri="direct:loadMultipleUnitSKUs" />
			<process ref="prepareMultipleUnitSKUsQuery" />
