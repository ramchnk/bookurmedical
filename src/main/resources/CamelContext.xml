				pattern="InOut" />
		</route>

		<route id="publishOrderNotificationToMQ">
			<from uri="direct:publishOrderNotificationToMQ" />
			<choice>
				<when>
					<simple>${exchangeProperty.hasOrderInDB} == false</simple>
					<setHeader headerName="userMessageName">
						<constant>ORDER_CREATED</constant>
					</setHeader>
					<process ref="constructOrderNotification" />
					<to uri="direct:notificationToUser" />
					<to uri="direct:publishMessageToBuyer" />
				</when>
				<when>
					<simple>${exchangeProperty.isNotifyOrderUpdates} == true</simple>
					<setHeader headerName="userMessageName">
						<simple>${exchangeProperty.userMessageName}</simple>
					</setHeader>
					<process ref="constructOrderNotification" />
					<to uri="direct:notificationToUser" />
				</when>
			</choice>
			<setHeader headerName="rabbitmq.DELIVERY_MODE">
				<constant>2</constant>
			</setHeader>
			<!-- we are going to publish message to fee always -->
			<setProperty propertyName="publishTo">
				<constant>feeManagement</constant>
			</setProperty>
			<process ref="constructRequestType" />
			<when>
				<simple>${exchangeProperty.publishMessage} != null</simple>
				<setHeader headerName="rabbitmq.ROUTING_KEY">
					<constant>feeManagementKey</constant>
				</setHeader>
				<convertBodyTo type="java.lang.String" />
				<to
					uri="rabbitmq://{{feemanagementmq.host}}:{{feemanagementmq.tx.port}}/feeManagementExchange?connectionFactory=#feeManagementTxConnectionFactory&amp;exchangeType=topic&amp;autoDelete=false&amp;durable=true&amp;declare=false"
					pattern="InOut" />
			</when>
			<when>
				<simple>${exchangeProperty.publishToQuickBooks} == true</simple>
				<setProperty propertyName="publishTo">
					<constant>quickbooks</constant>
				</setProperty>
				<process ref="constructRequestType" />
				<when>
					<simple>${exchangeProperty.publishMessage} != null</simple>
					<setHeader headerName="rabbitmq.ROUTING_KEY">
						<constant>quickbooksKey</constant>
					</setHeader>
					<convertBodyTo type="java.lang.String" />
					<to
						uri="rabbitmq://{{quickBooks.host}}:{{quickBooks.tx.port}}/quickbooksExchange?connectionFactory=#quickBooksTxConnectionFactory&amp;exchangeType=topic&amp;autoDelete=false&amp;durable=true&amp;declare=false"
						pattern="InOut" />
				</when>
			</when>
			<when>
				<simple>${exchangeProperty.publishToNinjaVan} == true</simple>
				<setProperty propertyName="publishTo">
					<constant>ninjaVan</constant>
				</setProperty>
				<process ref="constructRequestType" />
				<when>
					<simple>${exchangeProperty.publishMessage} != null</simple>
					<setHeader headerName="rabbitmq.ROUTING_KEY">
						<constant>ninjaVanKey</constant>
					</setHeader>
					<convertBodyTo type="java.lang.String" />
					<to
						uri="rabbitmq://{{ninjaVan.host}}:{{ninjaVan.tx.port}}/ninjaVanExchange?connectionFactory=#ninjaVanTxConnectionFactory&amp;exchangeType=topic&amp;autoDelete=false&amp;durable=true&amp;declare=false"
						pattern="InOut" />
				</when>
			</when>
			<when>
				<simple>${exchangeProperty.publishToInfor} == true</simple>
				<setProperty propertyName="publishTo">
					<constant>infor</constant>
				</setProperty>
				<process ref="constructRequestType" />
				<when>
					<simple>${exchangeProperty.publishMessage} != null</simple>
					<setHeader headerName="rabbitmq.ROUTING_KEY">
						<constant>inforKey</constant>
					</setHeader>
					<convertBodyTo type="java.lang.String" />
					<to
						uri="rabbitmq://{{infor.host}}:{{infor.tx.port}}/inforExchange?connectionFactory=#inforTxConnectionFactory&amp;exchangeType=topic&amp;autoDelete=false&amp;durable=true&amp;declare=false"
						pattern="InOut" />
				</when>
			</when>
			<when>
				<simple>${exchangeProperty.hasOrderInDB} == false and ${exchangeProperty.isSKUListEmpty} == false</simple>
				<to uri="direct:lowQuantityNotification" />
			</when>
			<when>
				<simple>${exchangeProperty.publishToSatsaco} == true</simple>
				<setProperty propertyName="publishTo">
					<constant>satsaco</constant>
				</setProperty>
				<process ref="constructRequestType" />
				<when>
					<simple>${exchangeProperty.groupOrderByCartNumber} == true</simple>
					<to uri="direct:groupOrderByCartNumber" />
				</when>
				<when>
					<simple>${exchangeProperty.publishMessage} != null and ${exchangeProperty.isEligibleToProceed} == true</simple>
					<setHeader headerName="rabbitmq.ROUTING_KEY">
						<constant>satsacoKey</constant>
					</setHeader>
					<convertBodyTo type="java.lang.String" />
					<to
						uri="rabbitmq://{{satsaco.host}}:{{satsaco.tx.port}}/satsacoExchange?connectionFactory=#satsacoTxConnectionFactory&amp;exchangeType=topic&amp;autoDelete=false&amp;durable=true&amp;declare=false"
						pattern="InOut" />
				</when>
			</when>
		</route>

		<route id="groupOrderByCartNumber">
		   <from uri="direct:groupOrderByCartNumber" />
		   <process ref="groupOrderByCartNumber" />
		</route>

		<route id="lowQuantityNotification">
			<from uri="direct:lowQuantityNotification" />
			<process ref="loadAccountData" />
			<process ref="loadInventoryData" />
